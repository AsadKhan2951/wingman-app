	<string>Wingman uses the microphone when you talk to it with a voice note.</string>
	<key>NSCameraUsageDescription</key>
	<string>Wingman uses the camera when you take a photo to share with it.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wingman opens your photos when you choose one to share with it.</string>
