# ─── Wingman Environment Configuration (template) ────────────────────

# Server
PORT=3000
NODE_ENV=development

# Public base URL of the deployment (used for OAuth redirect + links).
# In production set this to your Railway/custom domain, e.g. https://wingman.up.railway.app
PUBLIC_BASE_URL=http://localhost:3000

# Anthropic Claude API (LLM)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Database (mount a Railway volume at /app/data in production)
DATABASE_PATH=./data/wingman.db

# Google OAuth (Gmail + Calendar)
# In production the redirect URI must be <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# WhatsApp (whatsapp-web.js)
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# Set to 1 to run API + dashboard only (no WhatsApp) — handy for screenshot demos
DISABLE_WHATSAPP=0

# Admin key protecting the browser-based WhatsApp pairing page (/admin/qr?key=...)
# REQUIRED for /admin/qr, /_diag/*, /send, /trigger, /conversations. Unset = those stay closed.
ADMIN_PASSWORD=change-me

# Country code for numbers stored/typed without one (old 10-digit rows, 0300…).
# Full international numbers always match exactly.
LEGACY_PHONE_COUNTRY_CODE=92

# WhatsApp Business Cloud API (official Meta API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=wingman_verify
# Meta App Secret (App settings → Basic). Verifies X-Hub-Signature-256 on every
# webhook POST. Unset = webhooks accepted unverified (warning in logs).
WHATSAPP_APP_SECRET=
# Wingman's own number — also used for the sign-in "message Wingman" link.
WINGMAN_NUMBER=+16468627900
WHATSAPP_API_VERSION=v25.0

# Approved AUTHENTICATION template for OTP delivery — the code reaches any
# number, including brand-new users outside the 24h window.
OTP_TEMPLATE_NAME=wingman_login_otp
OTP_TEMPLATE_LANG=en_US
OTP_USE_TEMPLATE=1

# Approved UTILITY templates for messages Wingman sends OUTSIDE WhatsApp's 24h
# customer-service window (a briefing must arrive whether or not the user has
# been chatting). WhatsApp forbids newlines inside a template variable, so each
# template keeps its layout in its own static text and takes one variable per
# section. Parameter counts differ, so these never fall back to one another.
#   BRIEFING_TEMPLATE_NAME → 6 variables  {{1}}..{{6}}
#   WRAP_TEMPLATE_NAME     → 7 variables  {{1}}..{{7}}
#   PROACTIVE_TEMPLATE_NAME→ 1 variable   {{1}}   (short one-topic alerts)
BRIEFING_TEMPLATE_NAME=
WRAP_TEMPLATE_NAME=
PROACTIVE_TEMPLATE_NAME=
PROACTIVE_TEMPLATE_LANG=en_US
PROACTIVE_USE_TEMPLATE=1

# Weather (optional; falls back to a deterministic mock if unset)
WEATHER_API_KEY=
WEATHER_DEFAULT_CITY=Dubai

# Brevo transactional email API — used to SEND business-mailbox replies, because
# many hosts (e.g. Railway) block outbound SMTP. Reading still uses IMAP.
# Authenticate the sending domain in Brevo (SPF/DKIM) so mail isn't marked spam.
BREVO_API_KEY=
# Business-mail sending through the user's OWN mail server. DigitalOcean blocks
# SMTP ports on the droplet, so a Cloudflare Worker (relay/smtp-relay-worker.js)
# does the SMTP part. Same secret here and as the Worker's RELAY_SECRET.
SMTP_RELAY_URL=
SMTP_RELAY_SECRET=

# Landing-page waitlist → live Google Sheet. Deploy the Apps Script Web App bound
# to the sheet (see docs/waitlist-sheet.md), paste its /exec URL here, and every
# signup (email, IP, country) mirrors into the sheet in real time. Optional: set a
# matching secret in the script to reject writes without this token. Leave the URL
# blank to turn the feature off (signups still hit the DB + team email).
WAITLIST_SHEET_WEBHOOK_URL=
WAITLIST_SHEET_SECRET=

# Secret used to encrypt stored credentials at rest (webmail passwords, clock
# action secrets). Required for those features. Any long random string.
# Also signs connect links (/auth/google?…&sig=) and OAuth state. SET IT.
SECRET_KEY=

# In the Docker image the system Chromium is used by Puppeteer:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Wearable clouds — each is a one-click connect once its app credentials are set.
# Register an app with the provider, set the redirect URI to:
#   <PUBLIC_BASE_URL>/auth/wearable/callback
# A provider with no credentials simply shows as "Coming soon" in the UI.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Composio — third-party app bridge (Outlook/M365, Teams, Zoom, Slack, HubSpot,
# Pipedrive, WooCommerce, Facebook Pages, Instagram…). Off unless BOTH are set.
# Create one auth config per app in the Composio dashboard (use your OWN OAuth
# app for production so users see "Wingman" on the consent screen), then map
# toolkit slug -> auth config id. Docker --env-file: NO surrounding quotes.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIGS={"outlook":"ac_xxx","slack":"ac_yyy","hubspot":"ac_zzz"}
# Optional: pin exactly which tools each app exposes (keeps the prompt small):
# COMPOSIO_TOOLS={"slack":["SLACK_SEND_MESSAGE","SLACK_LIST_ALL_CHANNELS"]}
# COMPOSIO_TOOLS_PER_APP=12
# COMPOSIO_APPROVAL_TTL_MINUTES=30

# Waitlist thank-you email (template: src/templates/email/waitlist-thank-you.html).
# Sent via Brevo to each NEW waitlist signup, once per address. On whenever
# BREVO_API_KEY is set; WAITLIST_THANKYOU=0 turns it off. The From domain
# (imyourwingman.ai) must be authenticated in Brevo (SPF + DKIM + DMARC).
# Unsubscribe links are signed with SECRET_KEY (set it).
# WAITLIST_THANKYOU=1
# WAITLIST_THANKYOU_FROM=hello@imyourwingman.ai
# WAITLIST_THANKYOU_FROM_NAME=Wingman
# WAITLIST_THANKYOU_SUBJECT=You're on the list
# WAITLIST_EMAIL_PUBLIC_URL=https://app.imyourwingman.ai
# Team alert sender for each signup:
# WAITLIST_FROM=hello@wehearyou.studio

# WhatsApp briefing / wrap delivery outside the 24h window.
# *_READY_TEMPLATE_NAME = short "your X is ready" template with a quick-reply
# button. Meta often re-classifies that as MARKETING (limited delivery). Leave it
# empty to send the data-rich UTILITY template (BRIEFING_/WRAP_TEMPLATE_NAME)
# directly instead. WRAP_READY_TEMPLATE_NAME unset → uses the briefing's value.
# BRIEFING_READY_TEMPLATE_NAME=
# WRAP_READY_TEMPLATE_NAME=
# Variable layout of BRIEFING_TEMPLATE_NAME: 'full' (6 vars) or 'reminder'
# (3 vars: date, schedule, tasks — the UTILITY "wingman_schedule_reminder").
# BRIEFING_TEMPLATE_STYLE=reminder

# ── ElevenLabs: voice briefings ─────────────────────────────────────
# Voice notes with the briefing/wrap work as soon as the key is set (for users
# who turn on "Voice briefing"). WhatsApp CALLS additionally need:
#   - a NON-US/Canada WhatsApp business number with Calling enabled and a
#     2,000+/day messaging limit (Meta rule),
#   - that WABA imported in ElevenLabs (Agents → WhatsApp) with messaging OFF,
#   - an approved call-permission template (ELEVENLABS_CALL_PERMISSION_TEMPLATE),
#   - the agent: `docker exec wingman node scripts/setup-voice-agent.js`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Speech-to-text for WhatsApp voice notes (ElevenLabs Scribe).
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_AGENT_ID=
ELEVENLABS_CALLS=0
ELEVENLABS_CALL_PHONE_NUMBER_ID=
ELEVENLABS_CALL_PERMISSION_TEMPLATE=wingman_call_permission
ELEVENLABS_CALL_PERMISSION_TEMPLATE_LANG=en_US

# ── Sign in with Google / Apple (accounts) ──
# Google: a client with "openid email profile" only; redirect URI
#   https://app.imyourwingman.ai/api/auth/google/callback
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
# or reuse the main Google client (add the redirect URI above to it):
# GOOGLE_SIGNIN_ENABLED=1
# Apple: Services ID + Sign in with Apple key (.p8, newlines as \n); return URL
#   https://app.imyourwingman.ai/api/auth/apple/callback
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Uber rides (Uber for Business — Guest Rides API) ────────────────
# Wingman books Ubers for users on the business account. Needs the guests.trips
# scope granted by Uber. Webhook URL to give Uber: https://<host>/webhooks/uber
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ORG_ID=
# 1 = sandbox-api.uber.com (fake trips) while testing
UBER_SANDBOX=1

# Briefing calls as NORMAL phone calls (Twilio number imported into ElevenLabs)
# instead of WhatsApp calls (which Meta blocks from a US business number).
# ELEVENLABS_CALLS=1
# ELEVENLABS_CALL_CHANNEL=phone
# ELEVENLABS_PHONE_NUMBER_ID=      # ElevenLabs → Agents → Phone Numbers → the Twilio number's id
# ELEVENLABS_RING_SECONDS=45
